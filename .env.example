# ── NEXUS configuration via environment ──────────────────────────────────────
# Copy this file to `.env` in the repo root and fill in your values, or export
# these as real environment variables. Nothing here is secret by itself — the
# real keys live in your `.env`, which is git-ignored, or in config/api_keys.json.

# Gemini API key. When set, it takes priority over config/api_keys.json.
# Get one free at https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

# Optional — extra overrides are handled through ⚙ → settings.
# Provide the name the assistant should use (defaults to "NEXUS").
# ASSISTANT_NAME=NEXUS